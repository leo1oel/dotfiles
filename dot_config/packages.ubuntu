# Ubuntu/Debian package list
# Equivalent to Brewfile for apt package manager
# Install with: xargs -a packages.ubuntu sudo apt install -y (filters comments automatically)

# ===========================================
# Core Development Tools
# ===========================================
git
build-essential
curl
wget
cmake
pkg-config
software-properties-common
ca-certificates
gnupg
lsb-release

# ===========================================
# Shell & Terminal
# ===========================================
# fish - installed via PPA in run_once script
tmux

# ===========================================
# Modern CLI Tools (Rust-based alternatives)
# ===========================================
ripgrep
bat
fd-find
fzf
# zoxide - installed via GitHub release in run_once script (not in Ubuntu 20.04 repos)
# eza - better ls (requires custom repo, installed in run_once script)
# yazi - terminal file manager (not in apt for older Ubuntu, installed via GitHub release)
# glow - markdown renderer for the herdr-file-viewer plugin (not in apt; installed via GitHub release in update-tools.sh)

# ===========================================
# Editors
# ===========================================
# neovim - installed/updated by run_once script to ensure >= 0.8 for LazyVim
vim
nano

# ===========================================
# Programming Languages & Runtimes
# ===========================================
# Python
python3
python3-pip
python3-venv
python3-dev
python-is-python3

# ===========================================
# Python Development Tools
# ===========================================
# uv - installed via curl installer in run_once script
# pyenv - will be installed via git clone
# poetry - install via uv tool

# ===========================================
# Containers & Virtualization
# ===========================================
docker.io
docker-compose
docker-buildx

# ===========================================
# Development Tools
# ===========================================
# direnv - installed via GitHub release in run_once script (for non-sudo compatibility)
jq
tree
# btop - installed via GitHub release in run_once script (better than htop)
ncdu

# ===========================================
# Network Tools
# ===========================================
httpie
net-tools
dnsutils
traceroute
nmap
openssh-client
openssh-server

# ===========================================
# File Tools & Archives
# ===========================================
p7zip-full
p7zip-rar
unzip
zip
rsync
rclone

# ===========================================
# Git Tools
# ===========================================
git-lfs
git-flow
tig
# git-delta - installed via download in run_once script
# lazygit - installed via PPA in run_once script

# ===========================================
# LSP Servers & Language Tools (available via apt)
# ===========================================
# bash-language-server - not in Ubuntu 22.04 repos, install via npm
# yaml-language-server - not in Ubuntu 22.04 repos, install via npm
# typescript-language-server - install via npm
# python LSPs - install via pip (pyright, python-lsp-server)
# rust-analyzer - not needed (no Rust dev)

# ===========================================
# Formatters & Linters
# ===========================================
shellcheck
# shfmt - not available in Ubuntu 20.04 repos (install via GitHub or snap if needed)
# prettier - install via npm
# black - install via pip
# ruff - install via pip or cargo

# ===========================================
# Misc Utilities
# ===========================================
tldr
man-db
info
imagemagick
# fastfetch - installed via PPA or download in run_once script
neofetch
figlet
lolcat

# ===========================================
# System Monitoring
# ===========================================
iotop
sysstat
lm-sensors

# ===========================================
# Build Dependencies (for compiling from source)
# ===========================================
autoconf
automake
libtool
make
ninja-build
meson

# Libraries often needed
libssl-dev
libreadline-dev
libffi-dev
libbz2-dev
liblzma-dev
libncurses5-dev
libncursesw5-dev
