#!/bin/bash

set -e

{{ if eq .chezmoi.os "darwin" -}}
#################
# macOS - Homebrew
#################

# Check if Homebrew is installed
if command -v brew >/dev/null 2>&1; then
    echo "✅ Homebrew is already installed at $(command -v brew)"
else
    echo "🚀 Homebrew not found. Installing..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    # Add Homebrew to PATH depending on architecture
    if [[ -d "/opt/homebrew/bin" ]]; then
        echo 'export PATH="/opt/homebrew/bin:$PATH"' >> ~/.bash_profile
        export PATH="/opt/homebrew/bin:$PATH"
    elif [[ -d "/usr/local/bin" ]]; then
        echo 'export PATH="/usr/local/bin:$PATH"' >> ~/.bash_profile
        export PATH="/usr/local/bin:$PATH"
    fi

    echo "✅ Homebrew installation complete."
fi

#################
# Fish Shell
#################
if command -v fish >/dev/null 2>&1; then
    echo "✅ Fish shell is already installed at $(command -v fish)"
else
    echo "🚀 Fish shell not found. Installing..."
    brew install fish
    echo "Your password may be required to enable the Fish shell..."
    sudo sh -c "echo /opt/homebrew/bin/fish >> /etc/shells"
    chsh -s /opt/homebrew/bin/fish
fi

{{ else if eq .chezmoi.os "linux" -}}
#################
# Linux - APT
#################

echo "🐧 Setting up Linux environment..."

# Check if we have sudo privileges
HAS_SUDO=false
if sudo -n true 2>/dev/null; then
    HAS_SUDO=true
    echo "✅ Running with sudo privileges"
else
    echo "ℹ️  Running without sudo (user-space installation)"
fi

# Update package lists (only if we have sudo)
if [ "$HAS_SUDO" = true ]; then
    echo "📦 Updating package lists..."
    sudo apt update
fi

#################
# Install required packages for PPA management
#################
if [ "$HAS_SUDO" = true ]; then
    echo "📦 Installing software-properties-common..."
    sudo apt install -y software-properties-common
fi

#################
# Git (latest version via PPA)
#################
if [ "$HAS_SUDO" = true ]; then
    echo "🔧 Adding Git PPA for latest version..."
    sudo apt-add-repository ppa:git-core/ppa -y
    sudo apt update
    echo "📦 Installing/upgrading Git..."
    sudo apt install -y git
    echo "✅ Git $(git --version | awk '{print $3}') installed"
else
    echo "ℹ️  Using system Git (may be outdated)"
fi

#################
# Fish Shell
#################
if command -v fish >/dev/null 2>&1; then
    echo "✅ Fish shell is already installed at $(command -v fish)"
    FISH_PATH=$(which fish)
else
    if [ "$HAS_SUDO" = true ]; then
        echo "🚀 Installing Fish shell via PPA..."
        sudo apt-add-repository ppa:fish-shell/release-3 -y
        sudo apt update
        sudo apt install fish -y
        FISH_PATH=$(which fish)
        echo "✅ Fish shell installation complete."
    else
        # Try to install Fish to ~/.local without sudo
        echo "🚀 Installing Fish shell to ~/.local (no sudo)..."
        mkdir -p "$HOME/.local/bin"

        # Use official standalone binary from GitHub releases
        # These are single-file binaries that work on any Linux
        FISH_VERSION="4.1.2"
        FISH_URL="https://github.com/fish-shell/fish-shell/releases/download/${FISH_VERSION}/fish-${FISH_VERSION}-linux-x86_64.tar.xz"

        cd /tmp
        FISH_INSTALLED=false

        # Download standalone binary
        echo "📦 Downloading Fish ${FISH_VERSION} standalone binary..."
        if command -v wget >/dev/null 2>&1; then
            wget -q "$FISH_URL" -O fish.tar.xz 2>/dev/null && DOWNLOAD_OK=true || DOWNLOAD_OK=false
        elif command -v curl >/dev/null 2>&1; then
            curl -sL "$FISH_URL" -o fish.tar.xz 2>/dev/null && DOWNLOAD_OK=true || DOWNLOAD_OK=false
        else
            echo "⚠️  wget or curl not available. Cannot download Fish."
            DOWNLOAD_OK=false
        fi

        if [ "$DOWNLOAD_OK" = true ] && [ -f fish.tar.xz ]; then
            echo "📦 Extracting Fish binary..."

            # Extract the standalone binary
            tar -xf fish.tar.xz 2>/dev/null

            # The extracted file should be just 'fish'
            if [ -f fish ]; then
                chmod +x fish
                mv fish "$HOME/.local/bin/fish"
                FISH_INSTALLED=true
            fi

            # Cleanup
            rm -f fish.tar.xz fish
        fi

        if [ "$FISH_INSTALLED" = true ] && [ -x "$HOME/.local/bin/fish" ]; then
            FISH_PATH="$HOME/.local/bin/fish"
            echo "✅ Fish ${FISH_VERSION} installed to ~/.local/bin"

            # Initialize Fish data files on first run
            echo "📦 Initializing Fish data files..."
            export PATH="$HOME/.local/bin:$PATH"
            if echo "exit" | "$FISH_PATH" >/dev/null 2>&1; then
                echo "✅ Fish data files initialized"
            fi
        else
            echo "⚠️  Could not install Fish without sudo."
            echo "   Please ask your system administrator to run:"
            echo "   sudo apt install fish"
            FISH_PATH=""
        fi
    fi
fi

# Ensure ~/.local/bin is in PATH for all shells
if [ -d "$HOME/.local/bin" ]; then
    # Add to .profile (used by bash, sh, and login shells)
    if [ -f "$HOME/.profile" ]; then
        if ! grep -q 'PATH.*\.local/bin' "$HOME/.profile" 2>/dev/null; then
            cat >> "$HOME/.profile" << 'EOF'

# Add ~/.local/bin to PATH
if [ -d "$HOME/.local/bin" ] ; then
    PATH="$HOME/.local/bin:$PATH"
fi
EOF
        fi
    fi

    # Add to .bashrc (for bash)
    if [ -f "$HOME/.bashrc" ]; then
        if ! grep -q 'PATH.*\.local/bin' "$HOME/.bashrc" 2>/dev/null; then
            cat >> "$HOME/.bashrc" << 'EOF'

# Add ~/.local/bin to PATH
if [ -d "$HOME/.local/bin" ] ; then
    PATH="$HOME/.local/bin:$PATH"
fi
EOF
        fi
    fi

    # Add to .zshrc (for zsh)
    if [ -f "$HOME/.zshrc" ]; then
        if ! grep -q 'PATH.*\.local/bin' "$HOME/.zshrc" 2>/dev/null; then
            cat >> "$HOME/.zshrc" << 'EOF'

# Add ~/.local/bin to PATH
if [ -d "$HOME/.local/bin" ] ; then
    PATH="$HOME/.local/bin:$PATH"
fi
EOF
        fi
    fi
fi

# Set Fish as default shell (only if Fish is available)
if [ -n "$FISH_PATH" ] && [ -x "$FISH_PATH" ]; then
    echo "🐚 Setting Fish as default shell..."

    if [ "$HAS_SUDO" = true ]; then
        # With sudo: add to /etc/shells and change default shell
        if ! grep -q "$FISH_PATH" /etc/shells 2>/dev/null; then
            echo "$FISH_PATH" | sudo tee -a /etc/shells >/dev/null
        fi

        # Check current default shell
        CURRENT_SHELL=$(getent passwd "$USER" 2>/dev/null | cut -d: -f7)
        if [ "$CURRENT_SHELL" != "$FISH_PATH" ]; then
            if chsh -s "$FISH_PATH" 2>/dev/null; then
                echo "✅ Fish set as default shell. Please logout and login again."
            else
                echo "ℹ️  Could not set Fish as default shell"
                echo "   Try: sudo chsh -s $FISH_PATH $USER"
            fi
        else
            echo "✅ Fish is already the default shell."
        fi
    else
        # Without sudo: can't change default shell, but can auto-start Fish
        echo "ℹ️  Without sudo, cannot set Fish as system default shell."
        echo "   Fish will auto-start from bash via ~/.bashrc"

        # Add Fish auto-start to .bashrc if not already there
        if [ -f "$HOME/.bashrc" ]; then
            if ! grep -q "exec.*fish" "$HOME/.bashrc" 2>/dev/null; then
                cat >> "$HOME/.bashrc" << 'EOF'

# Auto-start Fish shell if available
if [ -x "$HOME/.local/bin/fish" ] && [ -z "$FISH_VERSION" ]; then
    exec "$HOME/.local/bin/fish"
fi
EOF
                echo "✅ Added Fish auto-start to ~/.bashrc"
            fi
        fi
    fi
fi

#################
# Essential tools (via curl installers)
#################
echo "🔧 Installing essential tools via curl installers..."

# Starship prompt
if ! command -v starship >/dev/null 2>&1; then
    echo "🚀 Installing Starship prompt..."
    mkdir -p "$HOME/.local/bin"
    if [ "$HAS_SUDO" = true ]; then
        # Install to /usr/local/bin with sudo
        curl -sS https://starship.rs/install.sh | sh -s -- -y
    else
        # Install to ~/.local/bin without sudo
        curl -sS https://starship.rs/install.sh | sh -s -- -y -b "$HOME/.local/bin"
    fi
    echo "✅ Starship installed"
fi

# uv (Python package manager)
if ! command -v uv >/dev/null 2>&1; then
    echo "📦 Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    echo "✅ uv installed"
fi

#################
# eza (better ls)
#################
if ! command -v eza >/dev/null 2>&1; then
    echo "📦 Installing eza..."
    mkdir -p "$HOME/.local/bin"
    wget -c https://github.com/eza-community/eza/releases/latest/download/eza_x86_64-unknown-linux-gnu.tar.gz -O - | tar xz
    chmod +x eza
    mv eza "$HOME/.local/bin/eza"
    echo "✅ eza installed to ~/.local/bin"
fi

#################
# git-delta (better git diff)
#################
if ! command -v delta >/dev/null 2>&1; then
    echo "📦 Installing git-delta..."
    mkdir -p "$HOME/.local/bin"
    DELTA_VERSION=$(curl -s https://api.github.com/repos/dandavison/delta/releases/latest | grep '"tag_name"' | sed -E 's/.*"([^"]+)".*/\1/')
    wget "https://github.com/dandavison/delta/releases/download/${DELTA_VERSION}/delta-${DELTA_VERSION}-x86_64-unknown-linux-gnu.tar.gz" -O /tmp/delta.tar.gz
    tar -xzf /tmp/delta.tar.gz -C /tmp
    mv "/tmp/delta-${DELTA_VERSION}-x86_64-unknown-linux-gnu/delta" "$HOME/.local/bin/"
    chmod +x "$HOME/.local/bin/delta"
    rm -rf /tmp/delta.tar.gz "/tmp/delta-${DELTA_VERSION}-x86_64-unknown-linux-gnu"
    echo "✅ git-delta installed to ~/.local/bin"
fi

#################
# lazygit (git TUI)
#################
if ! command -v lazygit >/dev/null 2>&1; then
    echo "📦 Installing lazygit..."
    mkdir -p "$HOME/.local/bin"
    LAZYGIT_VERSION=$(curl -s "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | grep -Po '"tag_name": "v\K[^"]*')
    wget "https://github.com/jesseduffield/lazygit/releases/latest/download/lazygit_${LAZYGIT_VERSION}_Linux_x86_64.tar.gz" -O /tmp/lazygit.tar.gz
    tar -xzf /tmp/lazygit.tar.gz -C /tmp
    mv /tmp/lazygit "$HOME/.local/bin/"
    chmod +x "$HOME/.local/bin/lazygit"
    rm /tmp/lazygit.tar.gz
    echo "✅ lazygit installed to ~/.local/bin"
fi

#################
# fzf (fuzzy finder)
#################
if ! command -v fzf >/dev/null 2>&1; then
    echo "📦 Installing fzf..."
    mkdir -p "$HOME/.local/bin"
    FZF_VERSION=$(curl -s https://api.github.com/repos/junegunn/fzf/releases/latest | grep '"tag_name"' | sed -E 's/.*"v?([^"]+)".*/\1/')
    wget "https://github.com/junegunn/fzf/releases/download/v${FZF_VERSION}/fzf-${FZF_VERSION}-linux_amd64.tar.gz" -O /tmp/fzf.tar.gz 2>/dev/null
    tar -xzf /tmp/fzf.tar.gz -C /tmp
    mv /tmp/fzf "$HOME/.local/bin/"
    chmod +x "$HOME/.local/bin/fzf"
    rm /tmp/fzf.tar.gz
    echo "✅ fzf installed to ~/.local/bin"
fi

#################
# zoxide (smarter cd)
#################
if ! command -v zoxide >/dev/null 2>&1; then
    echo "📦 Installing zoxide..."
    mkdir -p "$HOME/.local/bin"
    ZOXIDE_VERSION=$(curl -s https://api.github.com/repos/ajeetdsouza/zoxide/releases/latest | grep '"tag_name"' | sed -E 's/.*"v?([^"]+)".*/\1/')
    wget "https://github.com/ajeetdsouza/zoxide/releases/download/v${ZOXIDE_VERSION}/zoxide-${ZOXIDE_VERSION}-x86_64-unknown-linux-musl.tar.gz" -O /tmp/zoxide.tar.gz 2>/dev/null
    tar -xzf /tmp/zoxide.tar.gz -C /tmp
    mv /tmp/zoxide "$HOME/.local/bin/"
    chmod +x "$HOME/.local/bin/zoxide"
    rm /tmp/zoxide.tar.gz
    echo "✅ zoxide installed to ~/.local/bin"
fi

#################
# neofetch (system info)
#################
if ! command -v neofetch >/dev/null 2>&1; then
    echo "📦 Installing neofetch..."
    mkdir -p "$HOME/.local/bin"
    # neofetch is just a bash script, download directly from GitHub
    curl -fsSL "https://raw.githubusercontent.com/dylanaraps/neofetch/master/neofetch" -o "$HOME/.local/bin/neofetch"
    chmod +x "$HOME/.local/bin/neofetch"
    echo "✅ neofetch installed to ~/.local/bin"
fi

# Remove old fastfetch if it exists (causes GLIBC errors on older systems)
if [ -f "$HOME/.local/bin/fastfetch" ]; then
    rm -f "$HOME/.local/bin/fastfetch"
    echo "🧹 Removed old fastfetch binary"
fi

#################
# zellij (terminal multiplexer)
#################
if ! command -v zellij >/dev/null 2>&1; then
    echo "📦 Installing zellij..."
    mkdir -p "$HOME/.local/bin"
    ZELLIJ_VERSION=$(curl -s https://api.github.com/repos/zellij-org/zellij/releases/latest | grep '"tag_name"' | sed -E 's/.*"([^"]+)".*/\1/')
    wget "https://github.com/zellij-org/zellij/releases/download/${ZELLIJ_VERSION}/zellij-x86_64-unknown-linux-musl.tar.gz" -O /tmp/zellij.tar.gz
    tar -xzf /tmp/zellij.tar.gz -C /tmp
    mv /tmp/zellij "$HOME/.local/bin/"
    chmod +x "$HOME/.local/bin/zellij"
    rm /tmp/zellij.tar.gz
    echo "✅ zellij installed to ~/.local/bin"
fi

#################
# direnv (environment switcher)
#################
if ! command -v direnv >/dev/null 2>&1; then
    echo "📦 Installing direnv..."
    mkdir -p "$HOME/.local/bin"
    DIRENV_VERSION=$(curl -s https://api.github.com/repos/direnv/direnv/releases/latest | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/')
    wget "https://github.com/direnv/direnv/releases/download/v${DIRENV_VERSION}/direnv.linux-amd64" -O "$HOME/.local/bin/direnv"
    chmod +x "$HOME/.local/bin/direnv"
    echo "✅ direnv installed to ~/.local/bin"
fi

#################
# Create symlinks for renamed commands
#################
echo "🔗 Creating symlinks for commands with different names on Ubuntu..."

mkdir -p "$HOME/.local/bin"

# bat -> batcat
if command -v batcat >/dev/null 2>&1 && ! command -v bat >/dev/null 2>&1; then
    ln -sf "$(which batcat)" "$HOME/.local/bin/bat"
fi

# fd -> fdfind
if command -v fdfind >/dev/null 2>&1 && ! command -v fd >/dev/null 2>&1; then
    ln -sf "$(which fdfind)" "$HOME/.local/bin/fd"
fi

echo "✅ Linux setup complete."

{{ end -}}
