#!/bin/bash

set -e

{{ if eq .chezmoi.os "linux" -}}
#################
# AI & ML CLI Tools for Ubuntu
#################

echo "🤖 Installing AI and ML CLI tools..."

# Ensure PATH includes directories where tools are installed
export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$HOME/.local/share/fnm:$PATH"

# Check if we have sudo privileges
HAS_SUDO=false
if sudo -n true 2>/dev/null; then
    HAS_SUDO=true
fi

#################
# GitHub CLI
#################
if ! command -v gh >/dev/null 2>&1; then
    if [ "$HAS_SUDO" = true ]; then
        echo "📦 Installing GitHub CLI via apt..."
        type -p curl >/dev/null || sudo apt install curl -y
        curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg
        sudo chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
        sudo apt update
        sudo apt install gh -y
        echo "✅ GitHub CLI installed"
    else
        echo "📦 Installing GitHub CLI to ~/.local/bin..."
        mkdir -p "$HOME/.local/bin"
        GH_VERSION=$(curl -s https://api.github.com/repos/cli/cli/releases/latest | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/')
        wget "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" -O /tmp/gh.tar.gz
        tar -xzf /tmp/gh.tar.gz -C /tmp
        mv "/tmp/gh_${GH_VERSION}_linux_amd64/bin/gh" "$HOME/.local/bin/"
        chmod +x "$HOME/.local/bin/gh"
        rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_amd64"
        echo "✅ GitHub CLI installed to ~/.local/bin"
    fi
else
    echo "✅ GitHub CLI is already installed"
fi

#################
# Hugging Face CLI (via uv tool)
#################
if ! command -v hf >/dev/null 2>&1; then
    # Handle stale pipx/legacy symlink that blocks `uv tool install`.
    if [ -L "$HOME/.local/bin/hf" ] && [ ! -e "$HOME/.local/bin/hf" ]; then
        rm -f "$HOME/.local/bin/hf"
    fi
    echo "📦 Installing Hugging Face CLI..."
    uv tool install --force huggingface-hub
    echo "✅ Hugging Face CLI installed"
else
    echo "✅ Hugging Face CLI is already installed"
fi

#################
# wandb (via uv tool)
#################
if ! command -v wandb >/dev/null 2>&1; then
    # Handle stale pipx/legacy symlink that blocks `uv tool install`.
    if [ -L "$HOME/.local/bin/wandb" ] && [ ! -e "$HOME/.local/bin/wandb" ]; then
        rm -f "$HOME/.local/bin/wandb"
    fi
    echo "📦 Installing wandb..."
    uv tool install --force wandb
    echo "✅ wandb installed"
else
    echo "✅ wandb is already installed"
fi

#################
# gpustat (via uv tool)
#################
if ! command -v gpustat >/dev/null 2>&1; then
    # Handle stale symlink from previous tool managers.
    if [ -L "$HOME/.local/bin/gpustat" ] && [ ! -e "$HOME/.local/bin/gpustat" ]; then
        rm -f "$HOME/.local/bin/gpustat"
    fi
    echo "📦 Installing gpustat..."
    uv tool install --force gpustat
    echo "✅ gpustat installed"
else
    echo "✅ gpustat is already installed"
fi

#################
# Install fnm and Node.js LTS (required for Claude Code and Codex)
#################
# Install fnm if not present
if ! command -v fnm >/dev/null 2>&1; then
    echo "📦 Installing fnm (Fast Node Manager)..."

    # Try curl installer first
    FNM_INSTALLED=false
    if curl -fsSL --connect-timeout 10 --max-time 30 https://fnm.vercel.app/install | bash -s -- --skip-shell 2>&1; then
        export PATH="$HOME/.local/share/fnm:$PATH"
        if command -v fnm >/dev/null 2>&1; then
            echo "✅ fnm installed via curl"
            FNM_INSTALLED=true
        fi
    fi

    # If curl failed, use GitHub as fallback
    if [ "$FNM_INSTALLED" = false ]; then
        echo "⚠️  curl installation failed. Using GitHub release..."
        FNM_VERSION="v1.37.2"
        FNM_URL="https://github.com/Schniz/fnm/releases/download/${FNM_VERSION}/fnm-linux.zip"

        mkdir -p "$HOME/.local/share/fnm"
        if curl -fsSL -o /tmp/fnm.zip "$FNM_URL" && \
           unzip -o /tmp/fnm.zip -d /tmp && \
           mv /tmp/fnm "$HOME/.local/share/fnm/" && \
           chmod +x "$HOME/.local/share/fnm/fnm" && \
           rm -f /tmp/fnm.zip; then
            export PATH="$HOME/.local/share/fnm:$PATH"
            if command -v fnm >/dev/null 2>&1; then
                echo "✅ fnm installed from GitHub release"
            else
                echo "❌ fnm installation failed."
                exit 1
            fi
        else
            echo "❌ Failed to download fnm from GitHub."
            exit 1
        fi
    fi
fi

# Install and configure Node.js LTS via fnm
echo "📦 Installing Node.js LTS via fnm..."

# Initialize fnm environment (explicitly use bash syntax)
export PATH="$HOME/.local/share/fnm:$PATH"
eval "$(fnm env --shell bash --use-on-cd)"

# Install LTS version
fnm install --lts
fnm default lts-latest

# Source fnm environment to update PATH with installed node
eval "$(fnm env --shell bash)"

# Verify Node.js version
NODE_VERSION=$(node -v 2>/dev/null || echo "not found")
echo "✅ Node.js $NODE_VERSION installed"

# Note for shell reload
echo "ℹ️  Note: Fish shell will use the new Node.js version on next login"

#################
# Claude Code (via npm)
#################
if ! command -v claude >/dev/null 2>&1; then
    echo "📦 Installing Claude Code..."
    npm install -g @anthropic-ai/claude-code
    echo "✅ Claude Code installed"
else
    echo "✅ Claude Code is already installed"
fi

#################
# OpenAI Codex (via npm)
#################
if ! command -v codex >/dev/null 2>&1; then
    echo "📦 Installing OpenAI Codex..."
    npm install -g @openai/codex
    echo "✅ OpenAI Codex installed"
else
    echo "✅ OpenAI Codex is already installed"
fi

#################
# OpenCommit (via npm)
#################
if ! command -v oco >/dev/null 2>&1; then
    echo "📦 Installing OpenCommit..."
    npm install -g opencommit
    echo "✅ OpenCommit installed"
else
    echo "✅ OpenCommit is already installed"
fi

#################
# Optional: Bitwarden-based CLI logins (gh, wandb, huggingface)
#################
if [ -t 0 ]; then
    export PATH="$HOME/.local/bin:$PATH"
    echo "🔐 Optional: use Bitwarden to auto-login CLI tools"
    read -r -p "Set up Bitwarden-based logins now? [y/N] " BW_SETUP
    if [[ "$BW_SETUP" =~ ^[Yy]$ ]]; then
        if ! command -v bw >/dev/null 2>&1; then
            echo "⚠️  Bitwarden CLI (bw) not found. Skipping auto-login."
            echo "   Install it first, then re-run this script if needed."
        else
            BW_SESSION=""
            if bw login --check >/dev/null 2>&1; then
                echo "🔓 Bitwarden is already logged in. Unlocking vault..."
            else
                echo "🔐 Bitwarden login required."
                echo "   Tip: using API key avoids email OTP."
                read -r -p "Login with API key? [y/N] " BW_APIKEY_LOGIN
                if [[ "$BW_APIKEY_LOGIN" =~ ^[Yy]$ ]]; then
                    if [ -z "$BW_CLIENTID" ]; then
                        read -r -p "Bitwarden Client ID: " BW_CLIENTID
                    fi
                    if [ -z "$BW_CLIENTSECRET" ]; then
                        read -r -s -p "Bitwarden Client Secret: " BW_CLIENTSECRET
                        echo
                    fi
                    if [ -n "$BW_CLIENTID" ] && [ -n "$BW_CLIENTSECRET" ]; then
                        BW_CLIENTID="$BW_CLIENTID" BW_CLIENTSECRET="$BW_CLIENTSECRET" bw login --apikey >/dev/null 2>&1 || true
                    fi
                else
                    read -r -p "Bitwarden email: " BW_EMAIL
                    if [ -n "$BW_EMAIL" ]; then
                        bw login "$BW_EMAIL" >/dev/null 2>&1 || true
                    fi
                fi
            fi

            if bw login --check >/dev/null 2>&1; then
                echo "🔐 Enter Bitwarden master password to unlock (input hidden)"
                BW_SESSION=$(bw unlock --raw || true)
            fi

            if [ -n "$BW_SESSION" ]; then
                export BW_SESSION

                BW_GH_ITEM=${BW_GH_ITEM:-"GitHub CLI Token"}
                BW_WANDB_ITEM=${BW_WANDB_ITEM:-"W&B API Key"}
                BW_HF_ITEM=${BW_HF_ITEM:-"Hugging Face Token"}
                BW_AIBERM_ITEM=${BW_AIBERM_ITEM:-"AIBERM API Key"}

                GH_TOKEN=$(bw get password "$BW_GH_ITEM" 2>/dev/null || true)
                WANDB_API_KEY=$(bw get password "$BW_WANDB_ITEM" 2>/dev/null || true)
                HF_TOKEN=$(bw get password "$BW_HF_ITEM" 2>/dev/null || true)
                AIBERM_KEY=$(bw get password "$BW_AIBERM_ITEM" 2>/dev/null || true)

                if [ -n "$GH_TOKEN" ] && command -v gh >/dev/null 2>&1; then
                    printf '%s' "$GH_TOKEN" | gh auth login --with-token >/dev/null 2>&1 && echo "✅ gh authenticated"
                fi

                if [ -n "$WANDB_API_KEY" ] && command -v wandb >/dev/null 2>&1; then
                    wandb login "$WANDB_API_KEY" >/dev/null 2>&1 && echo "✅ wandb authenticated"
                fi

                if [ -n "$HF_TOKEN" ] && command -v huggingface-cli >/dev/null 2>&1; then
                    huggingface-cli login --token "$HF_TOKEN" >/dev/null 2>&1 && echo "✅ Hugging Face CLI authenticated"
                fi

                if [ -n "$AIBERM_KEY" ] && command -v oco >/dev/null 2>&1; then
                    if oco config set \
                        OCO_AI_PROVIDER=openai \
                        OCO_API_KEY="$AIBERM_KEY" \
                        OCO_API_URL=https://aiberm.com/v1 \
                        OCO_MODEL=openai/gpt-4o-mini \
                        OCO_TOKENS_MAX_INPUT=128000 \
                        OCO_TOKENS_MAX_OUTPUT=1024 \
                        OCO_EMOJI=true \
                        OCO_DESCRIPTION=false >/dev/null 2>&1; then
                        echo "✅ OpenCommit configured"
                        if oco hook set >/dev/null 2>&1; then
                            echo "✅ OpenCommit git hook enabled"
                        else
                            echo "⚠️  OpenCommit installed, but git hook setup failed (run: oco hook set)"
                        fi
                    else
                        echo "⚠️  OpenCommit config failed (run: oco config set ... manually)"
                    fi
                fi

                echo "ℹ️  Auto-login complete (missing tools or tokens are skipped)."
            else
                echo "⚠️  Could not unlock Bitwarden; skipping auto-login."
            fi
        fi
    fi
fi

#################
# Authentication Instructions
#################
echo ""
echo "🔐 Authentication Setup"
echo "======================="
NEEDS_GH=false
NEEDS_HF=false
NEEDS_WANDB=false
if command -v gh >/dev/null 2>&1; then
    if ! gh auth status >/dev/null 2>&1; then
        NEEDS_GH=true
    fi
fi
if command -v hf >/dev/null 2>&1; then
    if ! hf auth whoami >/dev/null 2>&1; then
        NEEDS_HF=true
    fi
fi
if command -v wandb >/dev/null 2>&1; then
    if [ -f ~/.netrc ] && grep -q "api.wandb.ai" ~/.netrc 2>/dev/null; then
        :
    elif [ -f ~/.config/wandb/settings ] && grep -q "api_key" ~/.config/wandb/settings 2>/dev/null; then
        :
    else
        NEEDS_WANDB=true
    fi
fi
if [ "$NEEDS_GH" = true ] || [ "$NEEDS_HF" = true ] || [ "$NEEDS_WANDB" = true ]; then
    echo "Run these commands to authenticate:"
    if [ "$NEEDS_GH" = true ]; then
        echo "  gh auth login                             # GitHub"
    fi
    if [ "$NEEDS_HF" = true ]; then
        echo "  hf auth login                             # Hugging Face"
    fi
    if [ "$NEEDS_WANDB" = true ]; then
        echo "  wandb login                               # Weights & Biases"
    fi
else
    echo "✅ All AI/ML CLI tools are authenticated."
fi
echo ""

{{ else if eq .chezmoi.os "darwin" -}}
#################
# AI & ML CLI Tools for macOS
#################

echo "🤖 Installing AI and ML CLI tools on macOS..."

# GitHub CLI
if ! command -v gh >/dev/null 2>&1; then
    echo "📦 Installing GitHub CLI..."
    brew install gh
else
    echo "✅ GitHub CLI is already installed"
fi

# Hugging Face CLI (via uv tool)
if ! command -v hf >/dev/null 2>&1; then
    echo "📦 Installing Hugging Face CLI..."
    uv tool install --force huggingface-hub
else
    echo "✅ Hugging Face CLI is already installed"
fi

# wandb (via uv tool)
if ! command -v wandb >/dev/null 2>&1; then
    echo "📦 Installing wandb..."
    uv tool install --force wandb
else
    echo "✅ wandb is already installed"
fi

# Ensure Node.js is installed (required for npm packages)
if ! command -v node >/dev/null 2>&1; then
    echo "📦 Installing Node.js..."
    brew install node
fi

# Claude Code (via npm)
if ! command -v claude >/dev/null 2>&1; then
    echo "📦 Installing Claude Code..."
    npm install -g @anthropic-ai/claude-code
else
    echo "✅ Claude Code is already installed"
fi

# OpenAI Codex (via npm)
if ! command -v codex >/dev/null 2>&1; then
    echo "📦 Installing OpenAI Codex..."
    npm install -g @openai/codex
else
    echo "✅ OpenAI Codex is already installed"
fi

echo ""
echo "🔐 Authentication Setup"
echo "======================="
NEEDS_GH=false
NEEDS_HF=false
NEEDS_WANDB=false
if command -v gh >/dev/null 2>&1; then
    if ! gh auth status >/dev/null 2>&1; then
        NEEDS_GH=true
    fi
fi
if command -v hf >/dev/null 2>&1; then
    if ! hf auth whoami >/dev/null 2>&1; then
        NEEDS_HF=true
    fi
fi
if command -v wandb >/dev/null 2>&1; then
    if [ -f ~/.netrc ] && grep -q "api.wandb.ai" ~/.netrc 2>/dev/null; then
        :
    elif [ -f ~/.config/wandb/settings ] && grep -q "api_key" ~/.config/wandb/settings 2>/dev/null; then
        :
    else
        NEEDS_WANDB=true
    fi
fi
if [ "$NEEDS_GH" = true ] || [ "$NEEDS_HF" = true ] || [ "$NEEDS_WANDB" = true ]; then
    echo "Run these commands to authenticate:"
    if [ "$NEEDS_GH" = true ]; then
        echo "  gh auth login                             # GitHub"
    fi
    if [ "$NEEDS_HF" = true ]; then
        echo "  hf auth login                             # Hugging Face"
    fi
    if [ "$NEEDS_WANDB" = true ]; then
        echo "  wandb login                               # Weights & Biases"
    fi
else
    echo "✅ All AI/ML CLI tools are authenticated."
fi
echo ""

{{ end -}}
