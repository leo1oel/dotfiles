#!/bin/bash

# This script runs whenever AI/ML CLI auth changes
# Hash: ai-ml-cli-auth-v1

{{ if eq .chezmoi.os "linux" -}}

set -e

echo "🔐 Checking AI/ML CLI authentication status..."
NEEDS_GH=false
NEEDS_HF=false
NEEDS_WANDB=false

#################
# GitHub CLI
#################
if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then
        echo "✅ GitHub CLI is authenticated"
    else
        echo "⚠️  GitHub CLI not authenticated. Run: gh auth login"
        NEEDS_GH=true
    fi
fi

#################
# Hugging Face CLI
#################
if command -v hf >/dev/null 2>&1; then
    if hf auth whoami >/dev/null 2>&1; then
        echo "✅ Hugging Face CLI is authenticated"
    else
        echo "⚠️  Hugging Face CLI not authenticated. Run: hf auth login"
        NEEDS_HF=true
    fi
fi

#################
# wandb
#################
if command -v wandb >/dev/null 2>&1; then
    # Check wandb config file instead of using 'wandb verify' (which can be unreliable)
    if [ -f ~/.netrc ] && grep -q "api.wandb.ai" ~/.netrc 2>/dev/null; then
        echo "✅ wandb is authenticated"
    elif [ -f ~/.config/wandb/settings ] && grep -q "api_key" ~/.config/wandb/settings 2>/dev/null; then
        echo "✅ wandb is authenticated"
    else
        echo "⚠️  wandb not authenticated. Run: wandb login"
        NEEDS_WANDB=true
    fi
fi

if [ "$NEEDS_GH" = true ] || [ "$NEEDS_HF" = true ] || [ "$NEEDS_WANDB" = true ]; then
    echo ""
    echo "📝 To authenticate, run:"
    if [ "$NEEDS_GH" = true ]; then
        echo "   gh auth login      # GitHub"
    fi
    if [ "$NEEDS_HF" = true ]; then
        echo "   hf auth login      # Hugging Face"
    fi
    if [ "$NEEDS_WANDB" = true ]; then
        echo "   wandb login        # Weights & Biases"
    fi
    echo ""
else
    echo ""
    echo "✅ All AI/ML CLI tools are authenticated."
    echo ""
fi

{{ end -}}
